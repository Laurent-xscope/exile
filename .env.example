# Supabase project URL and public anon key (used in the browser for auth only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only key. Required for room state, quiz storage, rate limiting, and
# diagnostics writes. Row Level Security grants no access to the anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Optional NotebookLM bridge (server-only). Cookie header exported from your own
# logged-in notebooklm.google.com session (must include OSID/SAPISID).
NOTEBOOKLM_COOKIE=
NOTEBOOKLM_BUILD_LABEL=

# AI provider (OpenAI-compatible)
AI_BASE_URL=https://api.kagiro.net/v1
AI_API_KEY=your-key-here
AI_MODEL=deepseek-v4.1-flash-1017
